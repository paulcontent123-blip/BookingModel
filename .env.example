# ============================================================================
# BookingModel.com — Environment Variables
# Copy this file to `.env.local` and replace the PLACEHOLDER values with real
# keys. The app runs WITHOUT any real key (falls back to a local JSON store,
# a mock payment provider and console e-mail), so you can fill these in later.
# ============================================================================

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BookingModel

# Secret used to sign the session cookie (JWT). MUST be changed in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=dev_only_change_me_0123456789abcdef0123456789abcdef0123456789abcdef
# Separate browser cookies for the public brand area and internal admin area.
BRAND_AUTH_COOKIE_NAME=bm_brand_session
ADMIN_AUTH_COOKIE_NAME=bm_admin_session

# ---------------------------------------------------------------------------
# DATABASE — Supabase  (leave blank => local JSON store at ./.data/db.json)
# See docs/SUPABASE_SETUP.md for the step-by-step guide.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_SERVICE_ROLE_KEY

# Force the JSON store even when Supabase keys are present (useful for demos)
# DB_DRIVER=memory

# ---------------------------------------------------------------------------
# GEO RESTRICTION  (requirement: US market only for booking + payment)
# ---------------------------------------------------------------------------
# ISO-3166 alpha-2 codes allowed to BOOK and PAY. Everyone else can browse the
# site but is routed to the "Contact our team" lead form instead of checkout.
PAYMENT_ALLOWED_COUNTRIES=US,CA

# Countries that get the localized "we will contact you" experience.
# (they are blocked from payment anyway — this only tunes the copy)
RESTRICTED_REGION_COUNTRIES=VN,TH,ID,PH,MY,SG,KH,LA,MM,BN,TL

# What to do when the country cannot be determined (local dev, proxies, VPN):
#   allow  -> treat as US (convenient for local development)
#   block  -> treat as restricted (safer for production)
GEO_UNKNOWN_POLICY=allow

# Optional IP lookup fallback when the hosting platform gives no geo header.
# Vercel (x-vercel-ip-country) and Cloudflare (cf-ipcountry) need NO key.
# ipinfo.io free tier: 50k req/mo — https://ipinfo.io/signup
IPINFO_TOKEN=PLACEHOLDER_ipinfo_token
# Provider: vercel | cloudflare | ipinfo | ipapi  (comma separated, in order)
GEO_PROVIDERS=vercel,cloudflare,ipinfo

# Allow ?geo=VN / ?geo=US in the URL to simulate a country. NEVER enable in prod.
NEXT_PUBLIC_GEO_DEBUG=true

# ---------------------------------------------------------------------------
# PAYMENTS  — provider: mock | stripe
# `mock` always succeeds and issues a real invoice record, so the whole
# booking -> payment -> invoice -> e-mail flow is testable with no key.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
# The platform fee is charged per plan tier (Free/Standard 15%, Pro 10%,
# Enterprise 8%) and lives in lib/plans.ts, not in an env var — a single flat
# rate cannot express the fee discount that Pro and Enterprise are sold on.
TAX_PERCENT=0
INVOICE_PREFIX=BM

# Stripe (fill in when you pick a provider) — https://dashboard.stripe.com/apikeys
# A real secret key also switches on self-serve plan upgrades (Stripe Checkout,
# subscription mode). Without it, upgrades go to Admin -> Plan Upgrades for review.
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER_stripe_webhook_secret

# Protects the hourly endpoint that expires unanswered creator invites.
# Generate a random value before deployment.
CRON_SECRET=PLACEHOLDER_random_cron_secret

# ---------------------------------------------------------------------------
# EMAIL — Resend (https://resend.com/api-keys)
# No key => e-mails are written to the console AND to the admin "Email log".
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_PLACEHOLDER_resend_api_key
EMAIL_FROM="BookingModel <no-reply@bookingmodel.com>"
EMAIL_REPLY_TO=hello@bookingmodel.com

# Where internal notifications (new booking, new lead, new applicant) are sent
ADMIN_EMAIL=admin@bookingmodel.com
SALES_EMAIL=sales@bookingmodel.com

# ---------------------------------------------------------------------------
# PUBLIC CONTACT DETAILS shown to visitors from restricted regions
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MANAGER_NAME="VEA Group — Partnerships Desk"
NEXT_PUBLIC_MANAGER_EMAIL=partnerships@bookingmodel.com
NEXT_PUBLIC_MANAGER_PHONE=+1 (302) 555-0142
NEXT_PUBLIC_MANAGER_WHATSAPP=+84 909 000 000
NEXT_PUBLIC_MANAGER_HOURS="Mon–Fri, 9:00–18:00 EST"

# ---------------------------------------------------------------------------
# MEDIA — Cloudinary (https://console.cloudinary.com/settings/api-keys)
# Creator uploads and remote URL re-hosting use signed server-side uploads.
# Without these keys, existing external photo_url values still render, but the
# Add/Edit Creator form cannot upload a new file or re-host a new URL.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=PLACEHOLDER_cloud_name
CLOUDINARY_API_KEY=PLACEHOLDER_cloudinary_api_key
CLOUDINARY_API_SECRET=PLACEHOLDER_cloudinary_api_secret
CLOUDINARY_FOLDER=bookingmodel/creators

# ---------------------------------------------------------------------------
# AI (Phase 2 — brief matching / creator suggestions)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER_anthropic_api_key
OPENAI_API_KEY=sk-PLACEHOLDER_openai_api_key

# ---------------------------------------------------------------------------
# RATE LIMITING (optional) — Upstash Redis
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://PLACEHOLDER.upstash.io
UPSTASH_REDIS_REST_TOKEN=PLACEHOLDER_upstash_token

# ---------------------------------------------------------------------------
# DEMO SEED ACCOUNTS (created by the seeder on first run)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@bookingmodel.com
SEED_ADMIN_PASSWORD=Admin@BM2026
SEED_BRAND_EMAIL=brand@demo.com
SEED_BRAND_PASSWORD=BrandDemo123
