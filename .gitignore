# Dependencies
node_modules/
.pnpm-store/

# Next.js / build output
.next/
out/
build/
dist/
.vercel/

# Environment files
# Keep example files; never commit real credentials or local overrides.
.env
.env.*
!.env.example
!.env*.example

# Local application data
.data/
tmp/

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state
# Keep supabase/config.toml, supabase/migrations/ and supabase/seed.sql tracked.
supabase/.temp/
supabase/.branches/
supabase/.cache/

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

